        {"path": "tests/controlplane/cp001/go-observer/main.go", "contains": "func run"}
      ],
      "observed_fields": ["process_id", "owner_generation", "config_generation", "lifecycle_phase", "shutdown_reason", "tls_generation", "log_level", "metrics_namespace"],
      "fault_scenarios": ["CP-FAULT-RUNTIME-CONFIG-RELOAD", "CP-FAULT-RUNTIME-MODULE-FAILURE", "CP-FAULT-PROCESS-DEATH"],
      "bridge_messages": [],
      "handoff": "All later Rust control modules compose through this process-local domain/runtime; no module may introduce a second process, transport, or protobuf domain model."
    },
